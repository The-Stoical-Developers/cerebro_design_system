{
  "$description": "Synapse brand semantic tokens — dark mode. Extracted from Cerebro_frontend globals.css .dark block. Defines the same keys as light.json (compiled in a separate pass to avoid collisions). primarySurface/primaryBorder are NEW tokens — dark-mode tints derived from primary #3C50E0.",
  "brand": {
    "color": {
      "bg":              { "$value": "{color.boxdark-2}",  "$type": "color", "$description": "Page background (globals.css .dark --color-bg)" },
      "surface":         { "$value": "{color.boxdark}",    "$type": "color", "$description": "Card/panel surface (--color-surface)" },
      "surfaceElevated": { "$value": "{color.strokedark}", "$type": "color", "$description": "Elevated surface — popovers, dropdowns (--color-surface-elevated)" },
      "surfaceHover":    { "$value": "{color.graydark}",   "$type": "color", "$description": "Surface hover state (--color-surface-hover)" },

      "sidebar": {
        "bg":         { "$value": "{color.boxdark-2}",  "$type": "color", "$description": "Sidebar background (--color-sidebar-bg)" },
        "text":       { "$value": "{color.bodydark}",   "$type": "color", "$description": "Sidebar item text (--color-sidebar-text)" },
        "textActive": { "$value": "{color.white}",      "$type": "color", "$description": "Sidebar active item text (--color-sidebar-text-active)" },
        "icon":       { "$value": "{color.bodydark2}",  "$type": "color", "$description": "Sidebar icon color (--color-sidebar-icon)" },
        "border":     { "$value": "{color.strokedark}", "$type": "color", "$description": "Sidebar border (--color-sidebar-border)" }
      },

      "border":       { "$value": "{color.strokedark}",      "$type": "color", "$description": "Default border (--color-border)" },
      "borderSubtle": { "$value": "{color.boxdark}",         "$type": "color", "$description": "Subtle border / internal dividers (--color-border-subtle)" },
      "borderStrong": { "$value": "{color.form-strokedark}", "$type": "color", "$description": "Strong border — focus, emphasis (--color-border-strong)" },

      "text": {
        "1": { "$value": "{color.bodydark1}", "$type": "color", "$description": "Primary text (--color-text-1)" },
        "2": { "$value": "{color.bodydark}",  "$type": "color", "$description": "Secondary text (--color-text-2)" },
        "3": { "$value": "{color.bodydark2}", "$type": "color", "$description": "Muted / tertiary text (--color-text-3)" },
        "4": { "$value": "{color.body}",      "$type": "color", "$description": "Faint / placeholder text (--color-text-4)" }
      },

      "primary":        { "$value": "{color.primary}",   "$type": "color", "$description": "Primary brand action color (--color-primary)" },
      "primaryHover":   { "$value": "#4A5EEA",           "$type": "color", "$description": "Primary hover/pressed on dark surfaces (--color-primary-hover); literal from globals.css" },
      "primarySurface": { "$value": "#2A3350",           "$type": "color", "$description": "NEW — soft primary tint surface (--color-primary-surface); derived from primary #3C50E0 for dark mode" },
      "primaryBorder":  { "$value": "#3D4A80",           "$type": "color", "$description": "NEW — soft primary border (--color-primary-border); derived from primary #3C50E0 for dark mode" },
      "success":        { "$value": "{color.success}",   "$type": "color", "$description": "Success green (--color-success)" },
      "danger":         { "$value": "{color.danger}",    "$type": "color", "$description": "Danger red (--color-danger)" },
      "warning":        { "$value": "{color.warning}",   "$type": "color", "$description": "Warning amber (--color-warning)" },
      "secondary":      { "$value": "{color.secondary}", "$type": "color", "$description": "Secondary accent (--color-secondary)" }
    },
    "scrollbar": {
      "thumb":      { "$value": "{color.strokedark}",      "$type": "color", "$description": "Scrollbar thumb (--scrollbar-thumb)" },
      "thumbHover": { "$value": "{color.form-strokedark}", "$type": "color", "$description": "Scrollbar thumb hover (--scrollbar-thumb-hover)" }
    }
  }
}
