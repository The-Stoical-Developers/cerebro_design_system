{
  "$description": "Synapse border radius primitives — extracted from Cerebro_frontend globals.css --radius-* variables.",
  "radius": {
    "xs":   { "$value": "2px",    "$type": "dimension", "$description": "Extra small radius — tags, tiny badges" },
    "sm":   { "$value": "4px",    "$type": "dimension", "$description": "Small radius — buttons, inputs" },
    "md":   { "$value": "6px",    "$type": "dimension", "$description": "Medium radius — menu items" },
    "lg":   { "$value": "8px",    "$type": "dimension", "$description": "Large radius — cards, panels (default surface radius)" },
    "xl":   { "$value": "12px",   "$type": "dimension", "$description": "Extra large radius — modals" },
    "2xl":  { "$value": "16px",   "$type": "dimension", "$description": "2x large radius — sheets, large containers" },
    "full": { "$value": "9999px", "$type": "dimension", "$description": "Pill radius — avatars, pills, switches" }
  }
}
